# Copier ce fichier en .env (ou definir ces variables dans ton environnement /
# ton outil de deploiement) - NE JAMAIS committer le vrai fichier .env.

DB_URL=jdbc:mysql://localhost:3306/guidly-db?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Genere une vraie valeur aleatoire longue en prod, ex: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_MS=86400000

AI_SERVICE_URL=http://localhost:8000
SERVER_PORT=8080
SHOW_SQL=false
